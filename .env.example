# Gelbooru Favourite Downloader - Credentials
# Copy this file to .env and fill in your credentials. Do NOT commit .env.
#
# To obtain your API credentials:
# 1. Log in to Gelbooru
# 2. Go to My Account -> Options -> API Access Credentials
# 3. Copy your API Key and User ID
#
# Username and Password are your normal Gelbooru login credentials.
#
# Wrap values in single quotes. Single quotes are taken literally, so special
# characters ($ @ * # & spaces) are preserved as-is. Single quotes cannot
# contain a literal ' character.

GELBOORU_API_KEY='your-api-key-here'
GELBOORU_USER_ID='your-user-id-here'
GELBOORU_USERNAME='your-username-here'
GELBOORU_PASSWORD='your-password-here'
